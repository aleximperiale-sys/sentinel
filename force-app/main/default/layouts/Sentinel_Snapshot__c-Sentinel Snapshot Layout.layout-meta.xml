<?xml version="1.0" encoding="UTF-8"?>
<!--
  Field hierarchy behind the Record Detail component on Sentinel_Snapshot_Record_Page.
  A snapshot answers "what was measured, when" then "how bad was it", so the label /
  object / date lead and the two counts follow. Autonumber and audit fields sink to
  the bottom. Name matches the object's default layout so this replaces it for every
  profile.

  No <relatedLists>: nothing in this schema is a child of Sentinel_Snapshot__c, so
  there is no child related list to declare here (see report).
-->
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>What Was Measured</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Label__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Object_API_Name__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Required</behavior>
                <field>Snapshot_Date__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Counts Captured</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Stale_Count__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Edit</behavior>
                <field>Critical_Count__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>false</editHeading>
        <label>System Information</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Name</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>CreatedById</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>LastModifiedById</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <showEmailCheckbox>false</showEmailCheckbox>
    <showHighlightsPanel>false</showHighlightsPanel>
    <showInteractionLogPanel>false</showInteractionLogPanel>
    <showRunAssignmentRulesCheckbox>false</showRunAssignmentRulesCheckbox>
    <showSubmitAndAttachButton>false</showSubmitAndAttachButton>
</Layout>
