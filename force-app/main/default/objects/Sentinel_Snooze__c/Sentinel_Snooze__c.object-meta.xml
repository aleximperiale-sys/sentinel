<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Assigns Sentinel_Snooze_Record_Page as the org-default Lightning record page.
         This View override IS the assignment: without it the FlexiPage is never shown. -->
    <actionOverrides>
        <actionName>View</actionName>
        <comment>Org default Lightning record page for Sentinel Snooze.</comment>
        <content>Sentinel_Snooze_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
    </actionOverrides>
    <!-- Drives the highlights panel on that record page. -->
    <compactLayoutAssignment>Sentinel_Snooze_Compact</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <label>Sentinel Snooze</label>
    <pluralLabel>Sentinel Snoozes</pluralLabel>
    <description>Records a rep's "still working it, stop nagging me" decision on a specific at-risk record until a given date. Read by SentinelService to exclude snoozed records from at-risk results.</description>
    <!-- Reachable and reportable now that the object has a tab. -->
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <nameField>
        <label>Snooze Number</label>
        <type>AutoNumber</type>
        <displayFormat>SNZ-{0000}</displayFormat>
    </nameField>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
